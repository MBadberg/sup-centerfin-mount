# =============================================================================
# FreeCAD Macro: Strap-Mounted Slide-In Fin Box for SUP/iSUP
# =============================================================================
# CORRECT VERSION: Proper Fin Box (Steckfinne) Construction
# Material: ABS (FDM 3D-Druck)
# Purpose: Removable fin box mounted with 2 cross straps
# =============================================================================

import FreeCAD as App
import FreeCADGui as Gui
from FreeCAD import Vector
import Part

# =============================================================================
# ======================== PARAMETRISCHE MASSE ==============================
# =============================================================================

# --- Fin Rail (Schiene an der Finne) - STANDARD MASSE ---
fin_rail_length = 185.0          # Länge der Finne-Schiene (180-190mm)
fin_rail_width = 35.0            # Breite der Finne-Schiene (33-37mm) 
fin_rail_height = 10.0           # Höhe der Finne-Schiene (ca. 10mm)
fin_rail_top_width = 4.3         # Oberste Nut-Breite (exakt!)

# --- Fin Box (Kasten - das, was wir bauen) ---
fin_box_length = fin_rail_length + 8.0      # Kasten-Länge (mit Puffer)
fin_box_width = fin_rail_width + 8.0        # Kasten-Breite (mit Wänden)
fin_box_height = fin_rail_height + 5.0      # Kasten-Höhe (mit Boden + Platz)
fin_box_bottom_thickness = 3.0              # Dicke des Bodens
fin_box_wall_thickness = 4.0                # Wanddicke (ABS-robust)
fin_box_inner_clearance = 0.5               # Spielraum innen

# --- Sicherungsstift ---
security_pin_diameter = 6.5                 # Durchmesser (Standard)
security_pin_pos_from_front = 45.0         # Position von vorne (mm)

# --- Mount Base (Auflageplatte auf SUP) ---
base_length = 105.0                         # Länge (Vorne-Hinten auf Board)
base_width = 160.0                          # Breite (Quer auf Board) 
base_thickness = 8.0                        # Dicke der Baseplatte
base_corner_radius = 10.0                   # Abgerundete Ecken

# --- Strap Guides (Gurtführungen) ---
strap_width = 30.0                          # Gurt-Breite (max 30mm)
strap_slot_width = 32.0                     # Schlitz-Breite (30 + Spiel)
strap_slot_depth = 6.0                      # Schlitz-Tiefe (Führungstiefe)
strap_slot_radius = 2.5                     # Radien in den Schlitzen
strap_front_pos = 18.0                      # Vordere Gurtführung (von vorne)
strap_rear_pos = base_length - 18.0         # Hintere Gurtführung (von hinten)

# --- Ribs & Reinforcements ---
rib_thickness = 5.0                         # Rippen-Dicke
rib_height = 8.0                            # Rippen-Höhe
rib_count = 2                                # Anzahl Verstärkungsrippen

# --- Material Toleranzen ---
print_tolerance = 0.2                       # 3D-Druck Toleranz

# =============================================================================
# ======================== HILFSFUNKTIONEN =================================
# =============================================================================

def create_document():
    """Erstelle frisches Dokument"""
    try:
        doc = App.activeDocument()
        if doc:
            for obj in doc.Objects:
                doc.removeObject(obj.Name)
    except:
        pass
    doc = App.newDocument("FinBoxMount")
    return doc

def create_rounded_box(length, width, height, position, corner_radius=2.0):
    """Erstelle Box mit abgerundeten Kanten"""
    box = Part.makeBox(length, width, height, position)
    
    # Finde Top-Kanten
    edges = [e for e in box.Edges if e.BoundBox.ZMax > height - 0.5]
    
    if edges and corner_radius > 0:
        try:
            box = box.makeFillet(corner_radius, edges)
        except:
            pass  # Wenn Fillet fehlschlägt, verwende Box ohne Fillet
    
    return box

# =============================================================================
# ======================== GEOMETRIE-ERSTELLUNG ============================
# =============================================================================

def create_base_plate():
    """Erstelle die Auflageplatte (unter dem Finnenkasten)"""
    print("  → Erstelle Base-Platte...")
    
    # Rechteckige Platte mit abgerundeten Ecken
    base = Part.makeBox(
        base_length,
        base_width,
        base_thickness,
        Vector(0, 0, 0)
    )
    
    # Abgerundete Ecken oben
    edges = [e for e in base.Edges if e.BoundBox.ZMax > base_thickness - 0.5]
    if edges:
        try:
            base = base.makeFillet(base_corner_radius, edges)
        except:
            pass
    
    return base

def create_fin_box_shell():
    """Erstelle die Finnenkasten-Schale (oben offen!)"""
    print("  → Erstelle Finnenkasten-Gehäuse...")
    
    # Der Kasten sitzt oben auf der Base
    box_height_total = fin_box_height
    
    # Äußeres Rechteck
    outer_box = Part.makeBox(
        fin_box_length,
        fin_box_width,
        box_height_total,
        Vector(
            (base_length - fin_box_length) / 2.0,  # Zentriert auf Base
            (base_width - fin_box_width) / 2.0,     # Zentriert auf Base
            base_thickness                           # Sitzt auf der Base
        )
    )
    
    # Inneres Rechteck (wird ausgehöhlt) - OBEN OFFEN!
    inner_length = fin_rail_length + fin_box_inner_clearance
    inner_width = fin_rail_width + fin_box_inner_clearance
    inner_height = box_height_total - fin_box_bottom_thickness
    
    inner_pos_x = (base_length - fin_box_length) / 2.0 + fin_box_wall_thickness
    inner_pos_y = (base_width - fin_box_width) / 2.0 + fin_box_wall_thickness
    inner_pos_z = base_thickness + fin_box_bottom_thickness
    
    inner_box = Part.makeBox(
        inner_length,
        inner_width,
        inner_height,
        Vector(inner_pos_x, inner_pos_y, inner_pos_z)
    )
    
    # Schale = Äußeres minus Inneres
    shell = outer_box.cut(inner_box)
    
    return shell

def create_fin_guides():
    """Erstelle interne Führungsleisten für die Finne"""
    print("  → Erstelle Finnen-Führungen...")
    
    # Die Finne sitzt in einer Nut in der Mitte des Kastens
    # Wir machen 2 Führungsleisten (oben und unten) für die Finne-Schiene
    
    guide_width = fin_box_wall_thickness / 2.0
    guide_height = fin_rail_height / 2.0
    guide_length = fin_rail_length + 2.0
    
    box_center_x = (base_length - fin_box_length) / 2.0
    box_center_y = (base_width - fin_box_width) / 2.0
    
    # Vordere Führungsleiste (unten im Kasten)
    guide_front = Part.makeBox(
        guide_length,
        fin_box_wall_thickness,
        guide_height,
        Vector(
            box_center_x + (fin_box_length - guide_length) / 2.0,
            box_center_y + fin_box_wall_thickness - 1.0,
            base_thickness + fin_box_bottom_thickness
        )
    )
    
    # Hintere Führungsleiste
    guide_rear = Part.makeBox(
        guide_length,
        fin_box_wall_thickness,
        guide_height,
        Vector(
            box_center_x + (fin_box_length - guide_length) / 2.0,
            box_center_y + fin_box_width - fin_box_wall_thickness + 1.0,
            base_thickness + fin_box_bottom_thickness
        )
    )
    
    # Kombiniere beide Guides
    guides = guide_front.fuse(guide_rear)
    return guides

def create_security_pin_hole():
    """Erstelle das Loch für den Sicherungsstift"""
    print("  → Erstelle Security-Pin-Loch...")
    
    # Pin-Loch quer durch den Kasten
    pin_radius = (security_pin_diameter + print_tolerance) / 2.0
    
    box_center_x = (base_length - fin_box_length) / 2.0
    box_center_y = (base_width - fin_box_width) / 2.0
    
    # Position des Pin-Lochs
    pin_x = box_center_x + (fin_box_length - fin_rail_length) / 2.0 + security_pin_pos_from_front
    pin_y_center = box_center_y + fin_box_width / 2.0
    pin_z = base_thickness + fin_box_height / 2.0
    
    # Zylinder quer durch (Y-Richtung)
    pin_hole = Part.makeCylinder(
        pin_radius,
        fin_box_width + 2.0,
        Vector(pin_x, pin_y_center - fin_box_width / 2.0 - 1.0, pin_z),
        Vector(0, 1, 0)  # Längs Y-Achse
    )
    
    return pin_hole

def create_strap_slots():
    """Erstelle die beiden Gurtführungsschlitze in der Base"""
    print("  → Erstelle Gurtschlitze...")
    
    slots = []
    
    # Vorderer Gurtschlitz
    front_slot = Part.makeBox(
        strap_slot_width,
        base_width + 4.0,
        strap_slot_depth,
        Vector(
            strap_front_pos - strap_slot_width / 2.0,
            -2.0,
            base_thickness - strap_slot_depth
        )
    )
    
    # Mit Radien abrunden
    edges = front_slot.Edges
    if edges and strap_slot_radius > 0:
        try:
            front_slot = front_slot.makeFillet(strap_slot_radius, edges[:4])
        except:
            pass
    
    slots.append(front_slot)
    
    # Hinterer Gurtschlitz
    rear_slot = Part.makeBox(
        strap_slot_width,
        base_width + 4.0,
        strap_slot_depth,
        Vector(
            strap_rear_pos - strap_slot_width / 2.0,
            -2.0,
            base_thickness - strap_slot_depth
        )
    )
    
    edges = rear_slot.Edges
    if edges and strap_slot_radius > 0:
        try:
            rear_slot = rear_slot.makeFillet(strap_slot_radius, edges[:4])
        except:
            pass
    
    slots.append(rear_slot)
    
    # Kombiniere beide Schlitze
    combined = slots[0].fuse(slots[1])
    return combined

def create_reinforcement_ribs():
    """Erstelle Verstärkungsrippen"""
    print("  → Erstelle Verstärkungsrippen...")
    
    box_center_y = (base_width - fin_box_width) / 2.0
    
    # Rippe vorne (vor dem Kasten)
    rib_front = Part.makeBox(
        rib_thickness * 3.0,
        rib_thickness * 2.0,
        rib_height,
        Vector(
            (base_length - rib_thickness * 3.0) / 2.0,
            box_center_y - rib_thickness * 2.0,
            base_thickness
        )
    )
    
    # Rippe hinten
    rib_rear = Part.makeBox(
        rib_thickness * 3.0,
        rib_thickness * 2.0,
        rib_height,
        Vector(
            (base_length - rib_thickness * 3.0) / 2.0,
            box_center_y + fin_box_width,
            base_thickness
        )
    )
    
    ribs = rib_front.fuse(rib_rear)
    return ribs

# =============================================================================
# ======================== HAUPTASSEMBLY ====================================
# =============================================================================

def create_complete_assembly():
    """Assembliere alle Teile"""
    print("  → Assembliere Teile...")
    
    # Einzelne Shapes erstellen
    base = create_base_plate()
    fin_box = create_fin_box_shell()
    guides = create_fin_guides()
    pin_hole = create_security_pin_hole()
    strap_slots = create_strap_slots()
    ribs = create_reinforcement_ribs()
    
    # Step 1: Base + Fin Box + Guides + Ribs (alle addieren)
    print("  → Verschmelze Base mit Finnenkasten...")
    result = base.fuse(fin_box)
    
    print("  → Füge Führungsleisten hinzu...")
    result = result.fuse(guides)
    
    print("  → Füge Verstärkungsrippen hinzu...")
    result = result.fuse(ribs)
    
    # Step 2: Schneidet Löcher raus
    print("  → Schneide Security-Pin-Loch...")
    result = result.cut(pin_hole)
    
    print("  → Schneide Gurtschlitze...")
    result = result.cut(strap_slots)
    
    return result

# =============================================================================
# ======================== HAUPTPROGRAMM ===================================
# =============================================================================

def main():
    """Hauptfunktion"""
    
    print("=" * 70)
    print("FreeCAD Macro: Strap-Mounted Slide-In Fin Box")
    print("=" * 70)
    print()
    
    doc = create_document()
    print("✓ Dokument erstellt")
    print()
    
    print("Erstelle 3D-Modell...")
    assembly_shape = create_complete_assembly()
    
    print("  → Konvertiere zu sichtbarem Objekt...")
    final_obj = doc.addObject("Part::Feature", "FinBoxMount")
    final_obj.Shape = assembly_shape
    final_obj.Label = "Strap-Mounted Slide-In Fin Box"
    
    # Sichtbarkeit
    final_obj.Visibility = True
    final_obj.ViewObject.Visibility = True
    final_obj.ViewObject.DisplayMode = 'Flat Lines'
    
    doc.recompute()
    print("✓ Modell erstellt!")
    print()
    
    # Parameter anzeigen
    print("=" * 70)
    print("PARAMETRISCHE MASSE")
    print("=" * 70)
    print(f"\n🔧 FIN RAIL (Finne-Schiene):")
    print(f"   Länge:        {fin_rail_length} mm")
    print(f"   Breite:       {fin_rail_width} mm")
    print(f"   Höhe:         {fin_rail_height} mm")
    print(f"   Top Groove:   {fin_rail_top_width} mm (EXAKT)")
    
    print(f"\n📦 FIN BOX (Kasten):")
    print(f"   Länge:        {fin_box_length} mm")
    print(f"   Breite:       {fin_box_width} mm")
    print(f"   Höhe:         {fin_box_height} mm")
    print(f"   Wandstärke:   {fin_box_wall_thickness} mm")
    print(f"   Boden:        {fin_box_bottom_thickness} mm")
    
    print(f"\n📍 BASE (Auflageplatte):")
    print(f"   Länge:        {base_length} mm")
    print(f"   Breite:       {base_width} mm")
    print(f"   Dicke:        {base_thickness} mm")
    
    print(f"\n🔐 SECURITY PIN:")
    print(f"   Durchmesser:  {security_pin_diameter} mm")
    print(f"   Position:     {security_pin_pos_from_front} mm (von vorne)")
    
    print(f"\n🎀 GURTFÜHRUNGEN:")
    print(f"   Gurt-Breite:  {strap_width} mm")
    print(f"   Schlitz:      {strap_slot_width} mm")
    print(f"   Tiefe:        {strap_slot_depth} mm")
    print(f"   Vorne:        {strap_front_pos} mm")
    print(f"   Hinten:       {strap_rear_pos} mm")
    
    print()
    print("=" * 70)
    print("EXPORT & DRUCK")
    print("=" * 70)
    print("1. Modell im Viewport anschauen")
    print("2. Objekt 'FinBoxMount' rechtsklick → 'Export as STL'")
    print("3. STL in deinen Slicer importieren")
    print()
    print("📋 ABS-DRUCKEINSTELLUNGEN:")
    print("   • Nozzle: 240-250°C")
    print("   • Bed: 100-110°C")
    print("   • Infill: 20-25%")
    print("   • Walls: 4-5 (≈ 5-7mm)")
    print("   • Speed: 40-50 mm/s")
    print("   • Support: Ja (Tree Supports)")
    print()
    print("=" * 70)
    
    # View anpassen
    try:
        Gui.activeDocument().resetEdit()
        Gui.SendMsgToActiveView("ViewFitAll")
        print("✓ Ansicht angepasst (View Fit All)")
    except:
        print("⚠ Ansicht konnte nicht angepasst werden (drücke V → F)")
    
    print("\n✅ FERTIG! Modell ist bereit zum Export.")

if __name__ == "__main__":
    main()
