# =============================================================================
# FreeCAD Macro: Strap-Mounted Slide-In Fin Box (T-Profil)
# =============================================================================
# FIXED VERSION: Simplified T-shape, proper visibility
# Material: ABS (FDM 3D-Druck)
# =============================================================================

import FreeCAD as App
import FreeCADGui as Gui
from FreeCAD import Vector
import Part

print("\n" + "="*75)
print("  STARTING FIN BOX MACRO")
print("="*75 + "\n")

# =============================================================================
# ======================== PARAMETRISCHE MASSE ==============================
# =============================================================================

# --- Finnen-Schiene (Standard Slide-In Masse) ---
fin_blade_length = 185.0         # Länge des Finnenblatts
fin_blade_width = 35.0           # Breite des Finnenblatts
fin_blade_height = 10.0          # Höhe des Finnenblatts

# --- Flansch (T-Form oben) ---
flansch_width = 36.0             # Breite des Flansches
flansch_length = 36.0            # Länge des Flansches
flansch_thickness = 2.5          # Dicke des Flansches

# --- Fin-Box (Kasten) ---
box_length = fin_blade_length + 10.0
box_width = fin_blade_width + 12.0
box_height = flansch_thickness + fin_blade_height + 8.0
box_wall_thickness = 5.0
box_bottom_thickness = 5.0

# --- Mount Base ---
base_length = 110.0
base_width = 170.0
base_thickness = 9.0
base_corner_radius = 10.0

# --- Strap Slots ---
strap_slot_width = 32.0
strap_slot_depth = 6.0
strap_front_pos = 20.0
strap_rear_pos = base_length - 20.0

# --- Security Pin ---
pin_diameter = 6.5
pin_hole_diameter = pin_diameter + 0.5

# --- Ribs ---
rib_thickness = 6.0
rib_height = 10.0

# =============================================================================
# ======================== HILFSFUNKTIONEN =================================
# =============================================================================

def create_document():
    """Erstelle neues Dokument"""
    try:
        doc = App.activeDocument()
        if doc:
            for obj in list(doc.Objects):
                doc.removeObject(obj.Name)
    except:
        pass
    doc = App.newDocument("FinBoxMount")
    print("✓ Dokument erstellt\n")
    return doc

def safe_fillet(shape, radius, edges):
    """Sichere Fillet-Operation"""
    if not edges or radius <= 0:
        return shape
    try:
        return shape.makeFillet(radius, edges)
    except Exception as e:
        print(f"  ⚠ Fillet fehlgeschlagen: {e}")
        return shape

# =============================================================================
# ======================== GEOMETRIE-ERSTELLUNG ============================
# =============================================================================

print("Erstelle Geometrie-Komponenten...\n")

def create_base():
    """Basis-Platte"""
    print("  1. Base-Platte...")
    base = Part.makeBox(base_length, base_width, base_thickness, Vector(0, 0, 0))
    
    # Oben abrunden
    edges = [e for e in base.Edges if e.BoundBox.ZMax > base_thickness - 0.5]
    base = safe_fillet(base, base_corner_radius, edges)
    
    return base

def create_fin_box():
    """T-förmiger Finnenkasten"""
    print("  2. Finnenkasten (T-Form)...")
    
    box_x = (base_length - box_length) / 2.0
    box_y = (base_width - box_width) / 2.0
    box_z = base_thickness
    
    # Äußeres Rechteck
    outer = Part.makeBox(box_length, box_width, box_height, Vector(box_x, box_y, box_z))
    
    # Innere Hohlräume - OBEN: Flansch
    flansch_cavity_x = box_x + (box_length - flansch_length) / 2.0
    flansch_cavity_y = box_y + (box_width - flansch_width) / 2.0
    flansch_cavity_z = box_z + box_height - flansch_thickness - 1.0
    
    flansch_cavity = Part.makeBox(
        flansch_length + 1.0,
        flansch_width + 1.0,
        flansch_thickness + 1.0,
        Vector(flansch_cavity_x, flansch_cavity_y, flansch_cavity_z)
    )
    
    # Innere Hohlräume - UNTEN: Blatt
    blade_cavity_x = box_x + (box_length - fin_blade_length) / 2.0
    blade_cavity_y = box_y + (box_width - fin_blade_width) / 2.0
    blade_cavity_z = box_z + box_bottom_thickness
    
    blade_cavity = Part.makeBox(
        fin_blade_length + 1.0,
        fin_blade_width + 1.0,
        fin_blade_height + 3.0,
        Vector(blade_cavity_x, blade_cavity_y, blade_cavity_z)
    )
    
    # Kombiniere Hohlräume
    cavities = flansch_cavity.fuse(blade_cavity)
    
    # Schneide aus
    shell = outer.cut(cavities)
    
    # Abrunden
    edges = [e for e in shell.Edges if len(e.BoundBox.Center) > 0]
    shell = safe_fillet(shell, 2.0, edges[:8] if len(edges) > 8 else edges)
    
    return shell

def create_pin_hole():
    """Sicherungsstift-Loch"""
    print("  3. Security-Pin-Loch...")
    
    box_x = (base_length - box_length) / 2.0
    box_y = (base_width - box_width) / 2.0
    box_z = base_thickness
    
    pin_x = box_x + box_length / 2.0 - 45.0
    pin_y = box_y - 1.0
    pin_z = box_z + box_height / 2.0
    
    pin_hole = Part.makeCylinder(
        pin_hole_diameter / 2.0,
        box_width + 4.0,
        Vector(pin_x, pin_y, pin_z),
        Vector(0, 1, 0)
    )
    
    return pin_hole

def create_strap_slots():
    """Gurtschlitze"""
    print("  4. Gurtschlitze...")
    
    # Vorne
    front = Part.makeBox(
        strap_slot_width,
        base_width + 4.0,
        strap_slot_depth,
        Vector(strap_front_pos - strap_slot_width/2.0, -2.0, base_thickness - strap_slot_depth)
    )
    
    # Hinten
    rear = Part.makeBox(
        strap_slot_width,
        base_width + 4.0,
        strap_slot_depth,
        Vector(strap_rear_pos - strap_slot_width/2.0, -2.0, base_thickness - strap_slot_depth)
    )
    
    slots = front.fuse(rear)
    return slots

def create_ribs():
    """Verstärkungsrippen"""
    print("  5. Verstärkungsrippen...")
    
    box_x = (base_length - box_length) / 2.0
    box_y = (base_width - box_width) / 2.0
    box_z = base_thickness
    
    # Vorne
    rib_front = Part.makeBox(
        rib_thickness * 3.0,
        rib_thickness * 2.5,
        rib_height,
        Vector(box_x + (box_length - rib_thickness*3.0)/2.0, box_y - rib_thickness*2.5, box_z)
    )
    
    # Hinten
    rib_rear = Part.makeBox(
        rib_thickness * 3.0,
        rib_thickness * 2.5,
        rib_height,
        Vector(box_x + (box_length - rib_thickness*3.0)/2.0, box_y + box_width, box_z)
    )
    
    ribs = rib_front.fuse(rib_rear)
    return ribs

# =============================================================================
# ======================== ASSEMBLY ==========================================
# =============================================================================

print("\nAssembliere Komponenten...\n")

base = create_base()
print("  ✓ Base erstellt")

fin_box = create_fin_box()
print("  ✓ Finnenkasten erstellt")

ribs = create_ribs()
print("  ✓ Rippen erstellt")

pin_hole = create_pin_hole()
print("  ✓ Pin-Loch erstellt")

strap_slots = create_strap_slots()
print("  ✓ Gurtschlitze erstellt")

print("\nVerschmelze Teile...\n")

# Addiere
print("  → Base + Kasten...")
result = base.fuse(fin_box)

print("  → + Rippen...")
result = result.fuse(ribs)

# Subtrahiere
print("  → - Pin-Loch...")
result = result.cut(pin_hole)

print("  → - Gurtschlitze...")
result = result.cut(strap_slots)

print("  ✓ Assembly komplett\n")

# =============================================================================
# ======================== FreeCAD OBJEKT ===================================
# =============================================================================

print("Erstelle FreeCAD-Dokument...\n")

doc = create_document()

print("  → Erstelle Part-Objekt...")
obj = doc.addObject("Part::Feature", "FinBoxMount")
obj.Shape = result

print("  → Setze Eigenschaften...")
obj.Visibility = True
obj.ViewObject.Visibility = True
obj.ViewObject.DisplayMode = "Flat Lines"
obj.Label = "Strap-Mounted Slide-In Fin Box"

print("  → Recompute...")
doc.recompute()

print("  ✓ Objekt erstellt und sichtbar\n")

# View
try:
    print("  → Passe Ansicht an...")
    Gui.activeDocument().resetEdit()
    Gui.SendMsgToActiveView("ViewFitAll")
    print("  ✓ Ansicht angepasst\n")
except Exception as e:
    print(f"  ⚠ Ansicht-Fehler: {e}\n")

# =============================================================================
# ======================== INFO =============================================
# =============================================================================

print("="*75)
print("  PARAMETRISCHE MASSE")
print("="*75)
print(f"\n  Finne:")
print(f"    Länge: {fin_blade_length}mm | Breite: {fin_blade_width}mm | Höhe: {fin_blade_height}mm")
print(f"\n  Flansch:")
print(f"    Größe: {flansch_width}×{flansch_length}mm | Dicke: {flansch_thickness}mm")
print(f"\n  Fin-Box:")
print(f"    Länge: {box_length}mm | Breite: {box_width}mm | Höhe: {box_height}mm")
print(f"    Wände: {box_wall_thickness}mm | Boden: {box_bottom_thickness}mm")
print(f"\n  Base:")
print(f"    Länge: {base_length}mm | Breite: {base_width}mm | Dicke: {base_thickness}mm")
print(f"\n  Gurtschlitze:")
print(f"    Vorne: {strap_front_pos}mm | Hinten: {strap_rear_pos}mm")
print(f"    Breite: {strap_slot_width}mm | Tiefe: {strap_slot_depth}mm")
print(f"\n  Security-Pin:")
print(f"    Durchmesser: {pin_hole_diameter}mm")
print("\n" + "="*75)
print("  EXPORT")
print("="*75)
print("\n  ✓ Modell ist sichtbar im Viewport!")
print("  1. Rechtsklick auf 'FinBoxMount' im Tree")
print("  2. 'Export as STL' wählen")
print("  3. STL-Datei speichern")
print("\n" + "="*75)
print("  ✅ FERTIG!")
print("="*75 + "\n")
